{
  "name": "dsh-workspace-docs",
  "version": "0.4.0",
  "description": "把当前工作区的文件/文档清单与代码图概览（入口候选、核心符号）注入模型可见的运行时上下文；索引后台增量维护，未就绪时回退文件清单。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "grammars/*.wasm",
    "cordis.patch.yml",
    "README.md",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs"
  },
  "dependencies": {
    "web-tree-sitter": "^0.27.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "workspace",
    "documentation",
    "context",
    "code-graph"
  ],
  "author": "Nova & 辉宝主人",
  "license": "MIT"
}
